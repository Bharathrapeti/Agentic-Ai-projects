<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    :root { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #e2e8f0; }
    body { margin: 0; background: transparent; }
    html, body { min-height: 100%; overflow: visible; }
    .box { border: 1px solid #263449; border-radius: 16px; padding: 12px; background: #111827; box-shadow: 0 12px 30px rgba(2, 6, 23, .22); box-sizing: border-box; }
    .camera-wrap { position: relative; overflow: hidden; border-radius: 11px; background: #020617; aspect-ratio: 16 / 9; }
    .camera { width: 100%; height: 100%; min-height: 0; border-radius: 11px; background: #020617; object-fit: cover; transform: scaleX(-1); display: block; }
    .camera-label { position: absolute; top: 9px; left: 9px; padding: 4px 8px; border-radius: 999px; background: rgba(2, 6, 23, .72); color: #cbd5e1; font-size: 0.7rem; font-weight: 700; letter-spacing: .02em; }
    .camera-state { margin-top: 8px; color: #94a3b8; font-size: 0.76rem; }
    .status-row { display: flex; align-items: center; gap: 7px; margin-top: 11px; color: #cbd5e1; font-size: .8rem; font-weight: 600; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 3px rgba(34, 197, 94, .14); }
    .state { margin-top: 9px; color: #f8fafc; font-size: 0.88rem; font-weight: 700; }
    .transcript { margin-top: 8px; min-height: 34px; max-height: 70px; overflow: auto; padding: 8px 10px; border: 1px solid #263449; border-radius: 9px; background: #0b1220; color: #cbd5e1; font-size: .78rem; line-height: 1.4; }
    .hint { margin-top: 7px; color: #94a3b8; font-size: 0.74rem; line-height: 1.35; }
    button { border: 1px solid #334155; border-radius: 8px; padding: 7px 11px; background: #1e293b; color: #e2e8f0; cursor: pointer; margin-top: 9px; font-weight: 600; }
    button:hover { background: #334155; }
  </style>
</head>
<body>
  <div class="box">
    <div class="camera-wrap">
      <video id="camera" class="camera" autoplay playsinline muted></video>
      <div class="camera-label">LIVE CAMERA</div>
    </div>
    <div id="cameraState" class="camera-state">Camera starting…</div>
    <div class="status-row"><span class="status-dot"></span><span id="micLabel">Microphone ready</span></div>
    <div id="state" class="state">Starting hands-free mode…</div>
    <div id="transcript" class="transcript">Listening status will appear here.</div>
    <div class="hint">Your microphone starts after the interviewer finishes speaking. Headphones help prevent echo.</div>
    <button id="retry">Start microphone now</button>
  </div>
  <script>
    const state = document.getElementById("state");
    const camera = document.getElementById("camera");
    const cameraState = document.getElementById("cameraState");
    const transcript = document.getElementById("transcript");
    const micLabel = document.getElementById("micLabel");
    const retry = document.getElementById("retry");
    let args = {}, speaking = false, listening = false, handled = false;
    let lastReplay = null;
    let lastQuestionToken = null;
    let audioContext, source, processor, stream, samples = [], startedAt = 0;
    let speakingDetected = false, lastVoiceAt = 0, levelTimer = null;
    let speakFallbackTimer = null;
    let nativeRecognition = null, nativeFinalText = "", nativeSilenceTimer = null;
    let waitingPromptTimer = null, waitingSupportTimer = null;
    let waitingPromptShown = false;
    let cameraStream = null, cameraStartPromise = null;
    const silenceMs = 2800;
    const waitingPromptMs = 9000;
    const waitingSupportMs = 18000;

    function send(type, extra = {}) {
      window.parent.postMessage({
        isStreamlitMessage: true,
        type: "streamlit:setComponentValue",
        value: {type, ...extra, at: Date.now()}
      }, "*");
    }
    function setState(text, canRetry = true) {
      state.textContent = text;
      retry.hidden = !canRetry;
      micLabel.textContent = text.toLowerCase().includes("listening") || text.toLowerCase().includes("hearing")
        ? "Listening for your answer" : "Microphone ready";
      if (!text.toLowerCase().includes("hearing")) transcript.textContent = text;
    }
    function setCameraState(text) {
      cameraState.textContent = text;
    }
    function stopCamera() {
      if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
        camera.srcObject = null;
      }
    }
    async function startCamera() {
      if (cameraStream) return true;
      if (cameraStartPromise) return cameraStartPromise;
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        setCameraState("Camera is unsupported in this browser. Use a current Chrome or Edge browser.");
        send("camera_status", {status: "error", error: "NotSupportedError"});
        return false;
      }
      setCameraState("Requesting camera permission…");
      send("camera_status", {status: "requesting"});
      cameraStartPromise = navigator.mediaDevices.getUserMedia({
        video: {facingMode: "user"},
        audio: false
      }).then(streamValue => {
        cameraStream = streamValue;
        camera.srcObject = streamValue;
        const track = streamValue.getVideoTracks()[0];
        if (!track || track.readyState !== "live") {
          throw new Error("Camera video track is not active.");
        }
        return new Promise((resolve, reject) => {
          const playVideo = () => {
            camera.play().then(() => {
              setCameraState("Camera connected.");
              send("camera_status", {status: "active", track: track.readyState});
              resolve(true);
            }).catch(reject);
          };
          if (camera.readyState >= HTMLMediaElement.HAVE_METADATA) playVideo();
          else camera.onloadedmetadata = playVideo;
        });
      }).catch(error => {
        stopCamera();
        const detail = error && error.name ? error.name : "UnknownError";
        setCameraState("Camera unavailable: " + detail + ". Allow camera access and reload the interview.");
        send("camera_status", {status: "error", error: detail});
        return false;
      }).finally(() => {
        cameraStartPromise = null;
      });
      return cameraStartPromise;
    }
    function encodeWav(input, sampleRate) {
      const buffer = new ArrayBuffer(44 + input.length * 2);
      const view = new DataView(buffer);
      const write = (offset, text) => [...text].forEach((c, i) => view.setUint8(offset + i, c.charCodeAt(0)));
      write(0, "RIFF"); view.setUint32(4, 36 + input.length * 2, true); write(8, "WAVE");
      write(12, "fmt "); view.setUint32(16, 16, true); view.setUint16(20, 1, true);
      view.setUint16(22, 1, true); view.setUint32(24, sampleRate, true);
      view.setUint32(28, sampleRate * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);
      write(36, "data"); view.setUint32(40, input.length * 2, true);
      input.forEach((value, i) => view.setInt16(44 + i * 2, Math.max(-1, Math.min(1, value)) * 0x7fff, true));
      let binary = ""; const bytes = new Uint8Array(buffer);
      for (let i = 0; i < bytes.length; i += 0x8000) binary += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
      return btoa(binary);
    }
    function nativeSpeechAvailable() {
      return Boolean(window.SpeechRecognition || window.webkitSpeechRecognition);
    }
    function stopNativeRecognition() {
      clearTimeout(nativeSilenceTimer);
      nativeSilenceTimer = null;
      if (nativeRecognition) {
        nativeRecognition.onend = null;
        nativeRecognition.stop();
        nativeRecognition = null;
      }
      listening = false;
    }
    function clearWaitingPrompts() {
      clearTimeout(waitingPromptTimer);
      clearTimeout(waitingSupportTimer);
      waitingPromptTimer = null;
      waitingSupportTimer = null;
      waitingPromptShown = false;
    }
    function scheduleWaitingPrompts() {
      clearWaitingPrompts();
      waitingPromptTimer = setTimeout(() => {
        if (listening && !speakingDetected && !handled) {
          waitingPromptShown = true;
          setState("Take your time; I’m listening.", true);
        }
      }, waitingPromptMs);
      waitingSupportTimer = setTimeout(() => {
        if (listening && !speakingDetected && !handled) {
          waitingPromptShown = true;
          setState("Would you like me to repeat the question or give you a moment to think?", true);
        }
      }, waitingSupportMs);
    }
    function finishNativeRecognition() {
      clearTimeout(nativeSilenceTimer);
      nativeSilenceTimer = null;
      clearWaitingPrompts();
      const text = nativeFinalText.trim();
      stopNativeRecognition();
      if (!text || handled) {
        setState("No speech was recognized. Press Start / retry microphone.", true);
        return;
      }
      handled = true;
      setState("Answer captured.");
      send("answer", {text});
    }
    function listenWithNativeSpeech() {
      const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      nativeRecognition = new Recognition();
      nativeRecognition.lang = args.language || "en-IN";
      nativeRecognition.continuous = true;
      nativeRecognition.interimResults = true;
      nativeFinalText = "";
      listening = true;
      nativeRecognition.onstart = () => setState("Listening for your answer…");
      nativeRecognition.onresult = event => {
        let interim = "";
        for (let i = event.resultIndex; i < event.results.length; i++) {
          const text = event.results[i][0].transcript;
          if (event.results[i].isFinal) nativeFinalText += text + " ";
          else interim += text;
        }
        const visible = (nativeFinalText + interim).trim();
        if (visible) {
          state.textContent = "Listening for your answer…";
          transcript.textContent = visible;
          micLabel.textContent = "Listening for your answer";
          clearWaitingPrompts();
        }
        clearTimeout(nativeSilenceTimer);
        nativeSilenceTimer = setTimeout(finishNativeRecognition, silenceMs);
      };
      nativeRecognition.onerror = event => {
        if (event.error === "not-allowed" || event.error === "service-not-allowed") {
          setState("Browser speech recognition permission was denied. Retrying with microphone recording.", true);
          stopNativeRecognition();
          listenWithRecorder();
        } else if (event.error !== "aborted") {
          setState("Browser speech recognition is unavailable. Retrying with microphone recording.", true);
          stopNativeRecognition();
          listenWithRecorder();
        }
      };
      nativeRecognition.onend = () => {
        if (listening && !handled) {
          clearTimeout(nativeSilenceTimer);
          nativeSilenceTimer = setTimeout(finishNativeRecognition, silenceMs);
        }
      };
      try {
        nativeRecognition.start();
      } catch (error) {
        stopNativeRecognition();
        listenWithRecorder();
      }
    }
    function listenWithRecorder() {
      if (!args.active || listening || speaking || handled) return;
      listening = true;
      scheduleWaitingPrompts();
      listenRecorder();
    }
    async function listenRecorder() {
      try {
        if (!stream) {
          stream = await navigator.mediaDevices.getUserMedia({audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true,
            channelCount: 1
          }});
          audioContext = new AudioContext();
          source = audioContext.createMediaStreamSource(stream);
          processor = audioContext.createScriptProcessor(4096, 1, 1);
          processor.onaudioprocess = event => {
            if (!listening) return;
            const data = event.inputBuffer.getChannelData(0);
            samples.push(...data);
            let sum = 0; for (const value of data) sum += value * value;
            const level = Math.sqrt(sum / data.length);
            if (level > 0.006) {
              speakingDetected = true;
              lastVoiceAt = Date.now();
              clearWaitingPrompts();
            }
            if (!waitingPromptShown) {
              state.textContent = speakingDetected
                ? "Listening for your answer…"
                : "Listening… start speaking";
              micLabel.textContent = speakingDetected ? "Listening for your answer" : "Microphone ready";
            }
            if (speakingDetected && Date.now() - lastVoiceAt > silenceMs && Date.now() - startedAt > 900) stopListening();
          };
          const silentOutput = audioContext.createGain();
          silentOutput.gain.value = 0;
          source.connect(processor); processor.connect(silentOutput); silentOutput.connect(audioContext.destination);
        }
        if (audioContext.state === "suspended") await audioContext.resume();
        samples = []; speakingDetected = false; startedAt = Date.now(); lastVoiceAt = startedAt;
        setState("Listening for your answer… I’ll stop after you pause.");
        scheduleWaitingPrompts();
      } catch (error) {
        listening = false;
        setState("Microphone could not start. Allow access and press Start / retry microphone.", true);
      }
    }
    async function listen() {
      if (!args.active || listening || speaking) return;
      if (handled) return;
      if (nativeSpeechAvailable()) listenWithNativeSpeech();
      else listenWithRecorder();
    }
    function stopListening() {
      if (nativeRecognition) { finishNativeRecognition(); return; }
      if (!listening || handled) return;
      listening = false;
      clearWaitingPrompts();
      const sampleRate = audioContext ? audioContext.sampleRate : 44100;
      if (samples.length < 3000) { setState("No speech level detected. Press Start / retry microphone.", true); return; }
      handled = true; setState("Answer captured. Converting to text…");
      send("answer", {audio: encodeWav(samples, sampleRate)});
    }
    function speak(text) {
      if (!text || !window.speechSynthesis) { listen(); return; }
      window.speechSynthesis.cancel();
      speaking = true;
      setState("Interviewer is speaking…");
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 0.96;
      clearTimeout(speakFallbackTimer);
      speakFallbackTimer = setTimeout(() => {
        if (speaking) {
          speaking = false;
          setState("Microphone starting… please wait, then speak.");
          listen();
        }
      }, Math.max(9000, text.length * 85));
      utterance.onend = () => {
        clearTimeout(speakFallbackTimer);
        speaking = false;
        setState("Microphone starting… please wait, then speak.");
        // Let speaker audio and browser audio buffers drain before opening the mic.
        setTimeout(listen, 1600);
      };
      utterance.onerror = () => {
        clearTimeout(speakFallbackTimer);
        speaking = false;
        setState("Microphone starting… please wait, then speak.");
        setTimeout(listen, 1600);
      };
      window.speechSynthesis.speak(utterance);
    }
    function render(data) {
      args = data.args || {};
      if (!args.active) {
        window.speechSynthesis.cancel();
        if (nativeRecognition) stopNativeRecognition();
        if (listening) { listening = false; }
        if (stream) stream.getTracks().forEach(track => track.stop());
        stopCamera();
        setCameraState("Camera stopped.");
        setState("Live mode is paused.");
        return;
      }
      startCamera();
      const questionToken = JSON.stringify({
        question: args.question || "",
        greeting: args.greeting || "",
        replay: args.replay || 0
      });
      if (questionToken === lastQuestionToken) return;
      lastQuestionToken = questionToken;
      lastReplay = args.replay;
      handled = false;
      const greeting = args.greeting || "";
      speak(greeting ? greeting + " " + args.question : args.question);
    }
    retry.onclick = () => {
      handled = false;
      window.speechSynthesis.cancel();
      speaking = false;
      if (listening) stopListening();
      listen();
    };
    window.addEventListener("message", event => {
      if (!event.data || event.data.type !== "streamlit:render") return;
      render(event.data);
    });
    window.addEventListener("load", () => {
      window.parent.postMessage({
        isStreamlitMessage: true,
        type: "streamlit:componentReady",
        apiVersion: 1
      }, "*");
      window.parent.postMessage({
        isStreamlitMessage: true,
        type: "streamlit:setFrameHeight",
        height: Math.ceil(document.body.scrollHeight + 8)
      }, "*");
    });
    const resizeObserver = new ResizeObserver(() => {
      window.parent.postMessage({
        isStreamlitMessage: true,
        type: "streamlit:setFrameHeight",
        height: Math.ceil(document.body.scrollHeight + 8)
      }, "*");
    });
    resizeObserver.observe(document.body);
    window.addEventListener("pagehide", stopCamera);
  </script>
</body>
</html>
